{
	"name": "@absolutejs/queue",
  "version": "0.8.0",
	"description": "A durable, typed job queue for Elysia and the AbsoluteJS ecosystem",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/queue.git"
	},
	"homepage": "https://github.com/absolutejs/queue",
	"bugs": {
		"url": "https://github.com/absolutejs/queue/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "BSL-1.1",
	"author": "Alex Kahn",
	"absolutejs": {
		"manifestContract": 2
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"queue",
		"jobs",
		"background-jobs",
		"worker",
		"absolutejs",
		"elysia",
		"bun"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/manifest.ts --outdir dist --sourcemap --target=bun --external elysia && tsc --project tsconfig.build.json && absolute-manifest emit",
		"config": "absolute config",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@absolutejs/telemetry": "^0.2.0",
		"@sinclair/typebox": "^0.34.0",
		"typebox": "1.3.16"
	},
	"peerDependencies": {
		"elysia": "^2.0.0-beta.6"
	},
	"devDependencies": {
		"@absolutejs/absolute": "^0.20.0-beta.0",
		"@types/bun": "1.2.9",
		"elysia": "2.0.0-beta.6",
		"exact-mirror": "1.2.4",
		"prettier": "3.5.3",
		"typescript": "5.8.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist",
		"README.md"
	]
}
